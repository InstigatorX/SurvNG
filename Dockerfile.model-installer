# One-shot SurvNG model downloader/exporter for Docker hosts.
# Does not include SurvNG runtime or model weights — only tooling to fetch them.
# License notices: docker/model-installer/NOTICE and THIRD_PARTY_MODELS.md
FROM ubuntu:24.04 AS model-installer

ARG SURVNG_GIT_SHA=

ENV DEBIAN_FRONTEND=noninteractive \
    SURVNG_INSTALLER_IN_CONTAINER=1 \
    SURVNG_MODELS_DIR=/models-out \
    SURVNG_CONFIG_DIR=/config-out

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxcb1 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/install

COPY scripts/install-docker-models.sh \
     scripts/export-mobileclip2-openvino.py \
     ./
COPY docker/model-installer/NOTICE \
     docker/model-installer/THIRD_PARTY_MODELS.md \
     ./

RUN chmod 755 install-docker-models.sh \
    && if [ -n "$SURVNG_GIT_SHA" ]; then printf '%s\n' "$SURVNG_GIT_SHA" > SURVNG_GIT_SHA; fi

VOLUME ["/models-out", "/config-out", "/cache"]

ENTRYPOINT ["/opt/install/install-docker-models.sh", "--native"]
