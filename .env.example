# Docker Compose host paths. This file contains no credentials. Copy it to
# .env; .env is ignored by Git and by the Docker build context.
TZ=UTC
SURVNG_UID=1000
SURVNG_GID=1000
SURVNG_CONFIG_DIR=./docker-data/config
SURVNG_DATA_DIR=./docker-data/data
SURVNG_MODELS_DIR=./docker-data/models
SURVNG_MEDIA_DIR=/srv/survng/media

# Optional: absolute path to the SurvNG Git checkout when the service does not
# run from that working directory.
# SURVNG_REPO_ROOT=/root/SurvNG

# Optional: bake the Git SHA into image builds (`git rev-parse HEAD`).
# SURVNG_GIT_SHA=

# Optional: host-mounted executable used by Admin → Update for Docker installs.
# SURVNG_UPDATE_HELPER=/host/scripts/update-from-git.sh

# Optional: absolute path to go2rtc config (default /config/go2rtc.yaml).
# SURVNG_GO2RTC_CONFIG=/config/go2rtc.yaml

# Optional: set to 0 to skip starting the bundled go2rtc binary (use an
# external go2rtc service instead).
# SURVNG_GO2RTC=1

# Optional Intel GPU device group IDs (`getent group video render`).
SURVNG_VIDEO_GID=44
SURVNG_RENDER_GID=993
