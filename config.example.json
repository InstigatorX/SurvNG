{
  "base_path": "/survng",
  "storage_dir": "survng/storage",
  "recording_index_dir": "",
  "media_storage": {
    "placement": "balanced",
    "locations": []
  },
  "ffmpeg_path": "ffmpeg",
  "event_clip_before_seconds": 5.0,
  "event_clip_after_seconds": 5.0,
  "recording_segment_seconds": 10.0,
  "image_storage": {
    "format": "webp",
    "quality": 95
  },
  "mqtt": {
    "enabled": false,
    "host": "",
    "port": 1883,
    "topic_prefix": "survng",
    "discovery_enabled": true,
    "server_status_enabled": true,
    "server_name": "SurvNG Server",
    "server_metrics_interval_seconds": 30
  },
  "retention": {
    "enabled": true,
    "automatic_cleanup": false,
    "storage_limit_tb": 13.0,
    "minimum_free_percent": 15.0,
    "target_free_percent": 20.0,
    "emergency_free_percent": 5.0,
    "main_days": 7,
    "live_days": 21,
    "snapshot_days": 1095,
    "cleanup_batch_files": 2000
  },
  "motion_qualification": {
    "mode": "camera_rescue",
    "sensitivity": "balanced",
    "stationary_object_tolerance": "balanced",
    "frame_width": 320,
    "sample_fps": 5.0,
    "window_seconds": 1.6,
    "post_trigger_seconds": 2.5,
    "burst_quiet_seconds": 0.5,
    "rejected_sample_rate": 1.0,
    "borderline_rescue_enabled": true,
    "borderline_margin": 0.03,
    "pipeline": {
      "qualification": [],
      "observation": [],
      "fusion": []
    }
  },
  "audit_ai": {
    "enabled": false,
    "assistant_enabled": true,
    "provider": "openai",
    "api_key": "",
    "base_url": "",
    "model": "",
    "assistant_reasoning_model": "",
    "timeout_seconds": 45.0,
    "allow_apply_recommendations": false
  },
  "semantic_search": {
    "enabled": false,
    "implementation": "mobileclip2_openvino",
    "model_dir": "",
    "device": "GPU",
    "index_full_frame": true,
    "index_object_crops": true,
    "max_object_crops_per_event": 24,
    "max_results": 100,
    "backfill_batch_size": 25,
    "backfill_pause_seconds": 0.25,
    "worker_queue_size": 256
  },
  "detector": {
    "enabled": false,
    "object_worker_count": 1,
    "model_path": "best.onnx",
    "model_xml": "",
    "labels_path": "classes.txt",
    "device": "CPU",
    "confidence_threshold": 0.45,
    "nms_threshold": 0.45,
    "event_confirmation_frames": 2,
    "event_class_confirmation_frames": {
      "robot_lawnmower": 3
    },
    "event_class_confidence_thresholds": {
      "robot_lawnmower": 0.75
    },
    "labels": [],
    "tracking": {
      "enabled": true,
      "implementation": "survng_hybrid",
      "excluded_labels": ["face"],
      "sample_fps": 2.0,
      "max_session_seconds": 15.0,
      "lost_timeout_seconds": 3.0,
      "min_confirmations": 2,
      "low_confidence_threshold": 0.25,
      "match_iou_threshold": 0.2,
      "match_center_distance_ratio": 0.65,
      "max_active_cameras": 2,
      "max_tracks_per_session": 100,
      "reid_enabled": false,
      "reid_model_path": "",
      "reid_device": "AUTO",
      "reid_match_threshold": 0.7,
      "reid_max_age_seconds": 30.0,
      "reid_max_embeddings_per_frame": 8,
      "reid_refresh_interval_frames": 8,
      "botsort_match_threshold": 0.8,
      "botsort_proximity_threshold": 0.1,
      "botsort_fuse_score": true
    }
  },
  "cameras": []
}
